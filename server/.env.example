# ===== Server Environment Variables =====
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- Server ---
NODE_ENV=development
PORT=4000

# --- PostgreSQL ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://ocj_user:ocj_password@localhost:5432/online_code_judge

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Authentication ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Rate Limiting ---
# Max submissions per user per minute
RATE_LIMIT_SUBMISSIONS=5

# --- Execution ---
# Max execution time per test case (milliseconds)
DEFAULT_TIME_LIMIT_MS=2000
# Max memory per container (megabytes)
DEFAULT_MEMORY_LIMIT_MB=256
