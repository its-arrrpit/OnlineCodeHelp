# ===================================================================
# Online Code Judge — Production Environment Variables
# ===================================================================

# Node Environment
NODE_ENV=production

# Server Ports
PORT=4000
PROD_HTTP_PORT=8080

# PostgreSQL Configuration
POSTGRES_USER=ocj_user
POSTGRES_PASSWORD=change_this_in_production_password!
POSTGRES_DB=online_code_judge
DATABASE_URL=postgresql://ocj_user:change_this_in_production_password!@postgres:5432/online_code_judge?schema=public

# Redis Configuration
REDIS_URL=redis://redis:6379

# Security / JWT
JWT_SECRET=generate-a-strong-random-512-bit-secret-for-production
JWT_EXPIRES_IN=7d

# Worker Pool
WORKER_CONCURRENCY=4
